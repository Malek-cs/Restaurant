// Lumière Restaurant OS — relational schema
// Money is stored as integers in the smallest currency unit (fils for JOD: 1 JOD = 1000 fils)
// so we never do floating point arithmetic on prices.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderSource {
  WEB
  ADMIN
}

enum PaymentMethod {
  CLIQ
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum OptionType {
  SIZE
  ADDON
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_RECEIVED
  ORDER_CANCELLED
  LOW_STOCK
  NEW_REVIEW
  SYSTEM
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

// ───────────────────────── Access control ─────────────────────────

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // SUPER_ADMIN, ADMIN, MANAGER, CASHIER, KITCHEN, DELIVERY
  name        String
  description String?
  rank        Int              @default(0) // higher rank can manage lower ranks
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. orders:view
  group       String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id])
  isActive           Boolean     @default(true)
  twoFactorEnabled   Boolean     @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  staff              Staff?
  sessions           Session[]
  auditLogs          AuditLog[]
  deliveries         Order[]     @relation("OrderDriver")
  statusEvents       OrderStatusEvent[]

  @@index([roleId])
}

model Staff {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  position  String?
  hiredAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// ───────────────────────── Restaurant ─────────────────────────

model Restaurant {
  id                String        @id @default(cuid())
  name              String
  tagline           String?
  description       String?
  story             String?
  logoUrl           String?
  coverImageUrl     String?
  phone             String?
  whatsappNumber    String?
  email             String?
  address           String?
  city              String?
  latitude          Float?
  longitude         Float?
  instagramUrl      String?
  facebookUrl       String?
  tiktokUrl         String?
  currency          String        @default("JOD")
  locale            String        @default("en")
  timezone          String        @default("Asia/Amman")
  taxRate           Float         @default(16) // percent
  serviceFeeRate    Float         @default(0) // percent
  minOrderAmount    Int           @default(0)
  deliveryEnabled   Boolean       @default(true)
  pickupEnabled     Boolean       @default(true)
  acceptingOrders   Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  openingHours      OpeningHour[]
  settings          RestaurantSetting[]
}

model OpeningHour {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0 = Sunday … 6 = Saturday
  opensAt      String     @default("17:30") // HH:mm, restaurant timezone
  closesAt     String     @default("23:30")
  isClosed     Boolean    @default(false)

  @@unique([restaurantId, dayOfWeek])
}

model RestaurantSetting {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key          String
  value        Json
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, key])
}

// ───────────────────────── Menu ─────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String?
  price             Int
  discountPrice     Int?
  imageUrl          String?
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  ingredients       String[]
  allergens         String[]
  prepTimeMinutes   Int             @default(15)
  isAvailable       Boolean         @default(true)
  isFeatured        Boolean         @default(false)
  isPopular         Boolean         @default(false)
  sortOrder         Int             @default(0)
  trackStock        Boolean         @default(false)
  stock             Int?
  lowStockThreshold Int             @default(5)
  options           ProductOption[]
  orderItems        OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isAvailable])
}

model ProductOption {
  id         String     @id @default(cuid())
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       OptionType
  name       String
  priceDelta Int        @default(0)
  isDefault  Boolean    @default(false)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)

  @@index([productId])
}

// ───────────────────────── Customers ─────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique // normalised E.164
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  reviews   Review[]

  @@index([createdAt])
}

// ───────────────────────── Delivery & promotions ─────────────────────────

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String
  description String?
  fee         Int      @default(0)
  minOrder    Int      @default(0)
  etaMinutes  Int      @default(45)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  description       String?
  type              CouponType
  value             Int // percent (1–100) or fils
  minOrder          Int        @default(0)
  maxDiscount       Int?
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?
  perCustomerLimit  Int?
  usedCount         Int        @default(0)
  isActive          Boolean    @default(true)
  isPublic          Boolean    @default(false) // shown as a public offer on the website
  orders            Order[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id              String      @id @default(cuid()) // unguessable, used in tracking URLs
  number          Int         @unique @default(autoincrement()) // human-friendly, shown to people
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  type            OrderType
  source          OrderSource @default(WEB)
  status          OrderStatus @default(NEW)

  subtotal        Int
  deliveryFee     Int         @default(0)
  discountTotal   Int         @default(0)
  serviceFee      Int         @default(0)
  taxTotal        Int         @default(0)
  total           Int

  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String?

  zoneId          String?
  zone            DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneName        String?
  addressLine     String?
  building        String?
  floor           String?
  apartment       String?
  deliveryNotes   String?
  notes           String?

  driverId        String?
  driver          User?       @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)

  estimatedReadyAt DateTime?
  cancelReason     String?
  placedAt         DateTime    @default(now())
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items           OrderItem[]
  payment         Payment?
  events          OrderStatusEvent[]
  messages        MessageLog[]
  review          Review?

  @@index([status])
  @@index([placedAt])
  @@index([customerId])
  @@index([driverId])
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  categoryName String?
  unitPrice   Int // includes option price deltas
  quantity    Int
  lineTotal   Int
  notes       String?
  options     OrderItemOption[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemOption {
  id          String     @id @default(cuid())
  orderItemId String
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  type        OptionType
  name        String
  priceDelta  Int        @default(0)
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Int
  provider    String?
  providerRef String?
  paidAt      DateTime?
  refundedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ───────────────────────── Reviews ─────────────────────────

model Review {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?      @unique
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([status])
  @@index([createdAt])
}

// ───────────────────────── Comms ─────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt, createdAt])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // ORDER_CONFIRMED, ORDER_READY, OUT_FOR_DELIVERY, ORDER_COMPLETED, PROMOTION
  name      String
  body      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model MessageLog {
  id          String        @id @default(cuid())
  templateKey String
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  to          String
  body        String
  provider    String
  status      MessageStatus @default(QUEUED)
  link        String?
  error       String?
  createdAt   DateTime      @default(now())
  sentAt      DateTime?

  @@index([orderId])
  @@index([createdAt])
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    String // e.g. order.status_changed
  entity    String // Order, Product, …
  entityId  String?
  summary   String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}
